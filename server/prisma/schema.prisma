generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  completed   Boolean   @default(false)
  important   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

// Retained for backwards-compatible database migrations. Productivity score
// values are now derived from Task records by the score endpoint.
model Score {
  id        Int      @id @default(autoincrement())
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}
